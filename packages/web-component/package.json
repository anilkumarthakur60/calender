{
  "name": "@calender/web-component",
  "version": "0.1.0",
  "description": "Framework-free <calender-picker> custom element built on @calender/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/index.js", "./dist/index.cjs", "./src/auto-register.ts"],
  "files": ["dist", "src", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auto-register": {
      "types": "./dist/auto-register.d.ts",
      "import": "./dist/auto-register.js",
      "require": "./dist/auto-register.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@calender/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
