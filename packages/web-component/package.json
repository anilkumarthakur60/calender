{
  "name": "@anil-labs/calendar-web-component",
  "version": "0.1.0",
  "description": "Framework-free <calender-picker> custom element built on @anil-labs/calendar-core.",
  "license": "MIT",
  "author": "Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "homepage": "https://github.com/anilkumarthakur60/calender/tree/main/packages/web-component#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/calender.git",
    "directory": "packages/web-component"
  },
  "bugs": "https://github.com/anilkumarthakur60/calender/issues",
  "keywords": [
    "calendar",
    "date-picker",
    "datepicker",
    "date-range",
    "date",
    "headless",
    "typescript",
    "web-component",
    "custom-element",
    "shadow-dom"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/auto-register.js",
    "./dist/auto-register.cjs",
    "./dist/auto-register.global.js",
    "./src/auto-register.ts"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auto-register": {
      "import": {
        "types": "./dist/auto-register.d.ts",
        "default": "./dist/auto-register.js"
      },
      "require": {
        "types": "./dist/auto-register.d.cts",
        "default": "./dist/auto-register.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anil-labs/calendar-core": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^20.12.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "unpkg": "./dist/auto-register.global.js",
  "jsdelivr": "./dist/auto-register.global.js",
  "typesVersions": {
    "*": {
      "auto-register": [
        "./dist/auto-register.d.ts"
      ]
    }
  }
}
