{
  "name": "@anil-labs/react",
  "version": "0.1.0",
  "description": "React 18+ adapter for @anil-labs/core.",
  "license": "MIT",
  "author": "Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "homepage": "https://github.com/anilkumarthakur60/calender/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/calender.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/anilkumarthakur60/calender/issues",
  "keywords": [
    "calendar",
    "date-picker",
    "datepicker",
    "date-range",
    "date",
    "headless",
    "typescript",
    "react",
    "react-component",
    "hooks"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anil-labs/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
