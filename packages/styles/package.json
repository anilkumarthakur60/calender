{
  "name": "@anil-labs/styles",
  "version": "0.1.0",
  "description": "SCSS source and compiled CSS theme for the @anil-labs renderers.",
  "license": "MIT",
  "author": "Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "homepage": "https://github.com/anilkumarthakur60/calender/tree/main/packages/styles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/calender.git",
    "directory": "packages/styles"
  },
  "bugs": "https://github.com/anilkumarthakur60/calender/issues",
  "keywords": [
    "calendar",
    "date-picker",
    "datepicker",
    "css",
    "scss",
    "theme",
    "styles"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md"
  ],
  "main": "./dist/calender.css",
  "style": "./dist/calender.css",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "sass": "./src/scss/calender.scss",
      "style": "./dist/calender.css",
      "default": "./dist/calender.css"
    },
    "./scss/*": "./src/scss/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "sass --no-source-map --style=compressed src/scss/calender.scss dist/calender.css && sass --no-source-map --style=expanded src/scss/calender.scss dist/calender.dev.css",
    "dev": "sass --watch src/scss/calender.scss dist/calender.css",
    "typecheck": "echo 'no ts'",
    "test": "echo 'no tests'"
  },
  "devDependencies": {
    "sass": "^1.102.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
