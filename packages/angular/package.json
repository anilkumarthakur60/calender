{
  "name": "@calender/angular",
  "version": "0.1.0",
  "description": "Angular 17+ adapter for @calender/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "src", "README.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@calender/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/common": ">=17"
  },
  "devDependencies": {
    "@angular/core": "^17.3.0",
    "@angular/common": "^17.3.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.14.0",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
