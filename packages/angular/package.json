{
  "name": "@anil-labs/angular",
  "version": "0.1.0",
  "description": "Angular 17+ adapter for @anil-labs/core.",
  "private": true,
  "license": "MIT",
  "author": "Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "homepage": "https://github.com/anilkumarthakur60/calender/tree/main/packages/angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/calender.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/anilkumarthakur60/calender/issues",
  "keywords": [
    "calendar",
    "date-picker",
    "datepicker",
    "date-range",
    "date",
    "headless",
    "typescript",
    "angular",
    "standalone-component"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@anil-labs/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/common": ">=17"
  },
  "devDependencies": {
    "@angular/core": "^21.2.0",
    "@angular/common": "^21.2.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.0",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
