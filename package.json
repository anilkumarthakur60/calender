{
  "name": "calender-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Headless, framework-agnostic calendar/date-picker for React, Vue, Svelte, Solid, Angular & Web Components.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "build:core": "pnpm --filter @calender/core run build",
    "build:apps": "pnpm -r --filter \"./apps/**\" run build",
    "build:all": "pnpm build && pnpm build:apps",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @calender/vue-playground run dev",
    "dev:vue": "pnpm --filter @calender/vue-playground run dev",
    "dev:react": "pnpm --filter @calender/react-playground run dev",
    "dev:svelte": "pnpm --filter @calender/svelte-playground run dev",
    "dev:solid": "pnpm --filter @calender/solid-playground run dev",
    "dev:wc": "pnpm --filter @calender/wc-playground run dev",
    "dev:docs": "pnpm --filter @calender/docs run dev",
    "build:docs": "pnpm --filter @calender/docs run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache .tsbuildinfo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@size-limit/esbuild": "^11.1.6",
    "@size-limit/file": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "size-limit": "^11.1.6",
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
